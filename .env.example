SECRET_KEY=change-moi-en-production
BASE_PUBLIC_URL=https://ton-domaine.com
# En local, omettre DATABASE_URL pour utiliser instance/app.db.
# En production, définir une URL de base persistante (par exemple PostgreSQL).
# DATABASE_URL=postgresql://...
APP_ENV=development
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Récupération de mot de passe : configurer dans l'environnement du serveur.
# STARTTLS : port 587, TLS=true, SSL=false. SSL direct : port 465, SSL=true.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=invitations@ton-domaine.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false
